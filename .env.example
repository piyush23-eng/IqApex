# ApexIQ Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=apexiq_user
POSTGRES_PASSWORD=apexiq_secure_pass
POSTGRES_DB=apexiq_telemetry
DATABASE_URL=postgresql+asyncpg://apexiq_user:apexiq_secure_pass@localhost:5432/apexiq_telemetry

# Downsampling & Performance Limits
MAX_RAW_TELEMETRY_POINTS=500000
DEFAULT_DOWNSAMPLE_TARGET=2000
